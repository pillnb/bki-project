generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pegawai {
  id                  Int                 @id @unique(map: "unique_id") @default(autoincrement())
  nup                 String              @unique(map: "unique_nup")
  nama_pegawai        String
  status_pegawai      String?
  jabatan             String?
  tempat_lahir        String?
  tanggal_lahir       DateTime?           @db.Date
  alamat              String?
  warga_negara        String?
  agama               String?
  no_telepon          String?
  email               String?
  password            String
  role                String[]            @default(["pegawai"])
  username            String?             @unique(map: "idx_pegawai_username")
  nik                 String?             @db.VarChar(32)
  jenjang_pend        String?
  pendidikan          String?
  tahun_pend          Int?
  tandaTanganUrl      String?
  cv_generated_at     DateTime? @db.Timestamp(6)
  pelatihan           pelatihan[]
  pengalaman_kerja    pengalaman_kerja[]
  suratTugasDibuat    SuratTugas[] @relation("DibuatOleh")
  anggotaTimDi        SuratTugas[] @relation("TimInspektor")
  leadApproverDi      SuratTugas[] @relation("LeadApprover")
  koorApproverDi      SuratTugas[] @relation("KoorApprover")
  smApproverDi        SuratTugas[] @relation("SmApprover")
  kacabApproverDi     SuratTugas[] @relation("KacabApprover")
  pengajuanSertifikat    Sertifikat[] @relation("PengajuSertifikat")

  loansCreated        Loan[]        @relation("LoanCreator")
  calibrationsCreated Calibration[] @relation("CalibrationCreator")
}

model Proyek {
  id          Int          @id @default(autoincrement())
  namaProyek  String
  klien       String
  lokasi      String
  suratTugas  SuratTugas[]
}

enum StatusPelatihan {
  ON_GOING
  VALID
  EXPIRED
}

model pelatihan {
  id_pelatihan         Int       @id @default(autoincrement())
  nup                  String?
  nama_pelatihan       String?
  penyelenggara        String?
  lokasi               String?
  nomor_sertifikat     String?
  file_sertifikat      String?
  tanggal_awal         DateTime? @db.Date
  masa_berlaku         DateTime? @db.Date
  status               StatusPelatihan
  keterangan_utilisasi String?
  tahun                Int?
  matrixCategory       String?
  tanggal_akhir        DateTime? @db.Date
  pegawaiId            Int?
  pegawai              pegawai? @relation(fields: [pegawaiId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model pengalaman_kerja {
  id_pengalaman    Int      @id @default(autoincrement())
  nup              String?
  tahun_awal       Int? @map("tahun")
  tahun_akhir      Int?
  pengalaman_kerja String?
  perusahaan       String?
  lokasi           String?
  pegawaiId        Int?
  pegawai          pegawai? @relation(fields: [pegawaiId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum StatusSuratTugas {
  DRAFT                 // Saat surat masih dalam pengeditan oleh pembuat
  MENUNGGU_LEAD         // Menunggu persetujuan Lead Inspector
  MENUNGGU_KOORDINATOR  // Menunggu persetujuan Koordinator Bidang
  MENUNGGU_SM           // Menunggu persetujuan Senior Manager
  MENUNGGU_KACAB        // Menunggu persetujuan Kepala Cabang
  DISETUJUI             // Semua level sudah menyetujui, siap generate dokumen
  BERJALAN              // Tim sedang bertugas di lapangan
  SELESAI               // Tugas telah selesai dan tim sudah kembali
  DITOLAK               // Pengajuan ditolak oleh salah satu approver
}

model SuratTugas {
  id                            Int      @id @default(autoincrement())
  nomor_surat                   String?  @unique
  proyekId                      Int?
  proyek                        Proyek?   @relation(fields: [proyekId], references: [id])
  status_pekerjaan              String?
  no_service_order              String?
  bidang_pekerjaan              String?
  peralatan_inspeksi            String[]
  cabang_pinjam                 String?
  pihak_ketiga                  String?
  kebutuhan_material            String[]
  tanggal_berangkat             DateTime?
  tanggal_kembali               DateTime?
  transportasi_operasional      Boolean             @default(false)
  nomor_plat_kendaraan          String?
  transportasi_ditanggung_klien Boolean             @default(false)
  transportasi_asal_tujuan      Boolean             @default(false)
  transportasi_dinas            Boolean             @default(false)
  tiket                         Boolean             @default(false)
  penginapan                    Boolean             @default(false)
  keterangan_lain               String?
  leadInspectorId               Int?
  leadInspector                 pegawai? @relation("LeadApprover", fields: [leadInspectorId], references: [id])
  disetujuiLeadAt               DateTime?
  koordinatorId                 Int?
  koordinator                   pegawai? @relation("KoorApprover", fields: [koordinatorId], references: [id])
  disetujuiKoorAt               DateTime?
  seniorManagerId               Int?
  seniorManager                 pegawai? @relation("SmApprover", fields: [seniorManagerId], references: [id])
  disetujuiSmAt                 DateTime?
  kepalaCabangId                Int?
  kepalaCabang                  pegawai? @relation("KacabApprover", fields: [kepalaCabangId], references: [id])
  disetujuiKacabAt              DateTime?
  catatanPenolakan              String?
  timInspektor                  pegawai[] @relation("TimInspektor")
  dibuatOlehId                  Int?
  dibuatOleh                    pegawai?  @relation("DibuatOleh", fields: [dibuatOlehId], references: [id])
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  spi                           String?
  wbs                           String?
  status                        StatusSuratTugas    @default(MENUNGGU_LEAD)
}

model GoogleOAuthToken {
  id          Int      @id @default(autoincrement())
  ownerEmail  String   // email pemilik Drive (misal admin)
  accessToken String?
  refreshToken String?
  scope       String?
  tokenType   String?
  expiryDate  BigInt?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerEmail])
}

enum StatusSertifikat {
  PENDING_APPROVAL  // Baru disubmit, menunggu admin review
  APPROVED          // Sudah diapprove, nomor & QR sudah digenerate
  REJECTED          // Ditolak admin
  CANCEL            // Terdapat kesalahan sehingga perlu dibatalkan
}

model Sertifikat {
  id                      Int               @id @default(autoincrement())
  pengajuId               Int
  pengaju                 pegawai           @relation("PengajuSertifikat", fields: [pengajuId], references: [id])
  parentId                Int?              // Reference ke halaman pertama/parent

  // Data dari Form Input
  nomorKontrak            String            
  kompetensi              String            
  pasar                   String            
  kodeProduksiM           String?           
  kodeProduksiE           String?           
  jumlahHalaman           Int?              
  linkLaporan             String            
  
  // Data Generated (setelah approve)
  nomorSertifikat         String?           @unique 
  qrCodeDriveId           String?           
  qrCodeUrl               String?           
  qrCodeImageUrl          String?           
  
  // Approval Data
  status                  StatusSertifikat  @default(PENDING_APPROVAL)
  approvedByAdmin         String?           // NUP admin yang approve (jika bukan pegawai)
  approvedAt              DateTime?
  rejectedAt              DateTime?
  keterangan              String?           
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  @@index([parentId])
  @@index([pengajuId])
  @@index([status])
}

model SertifikatCounter {
  id          Int      @id @default(autoincrement())
  tahun       String   @unique // '2025', '2026', dst
  sequence    Int      @default(0) // counter: 1, 2, 3, ...
  updatedAt   DateTime @updatedAt
}

enum ToolCondition {
  Good
  Damaged
}

enum EmergentRole {
  SuperAdmin
  Admin
  User
  Management
}

// INTEGRASI SISTEM EMERGENT (Inventory & Dashboard)

// Pengganti bki_modules (Menu Management)
model ModuleAccess {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  path        String
  externalUrl String?  @map("external_url")
  isActive    Boolean  @default(true) @map("is_active")
  roles       String[] // Array role yang diizinkan akses modul ini

  @@map("bki_modules")
}

// Pengganti em_tools
model Tool {
  id                        String        @id @default(uuid())
  equipmentName             String        @map("equipment_name")
  brandType                 String        @map("brand_type")
  serialNo                  String        @map("serial_no")
  inventoryCode             String        @map("inventory_code")
  assetNumber               String?       @map("asset_number")
  periodicInspectionDate    DateTime?     @map("periodic_inspection_date") @db.Date
  calibrationDate           DateTime?     @map("calibration_date") @db.Date
  calibrationValidityMonths Int           @default(12) @map("calibration_validity_months")
  condition                 ToolCondition // Menggunakan Enum
  description               String?
  equipmentLocation         String        @map("equipment_location")
  calibrationCertificate    String?       @map("calibration_certificate") // Path file
  equipmentManual           String?       @map("equipment_manual") // Path file
  
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  @@map("em_tools")
}

// Pengganti em_stock_items
model StockItem {
  id                  String   @id @default(uuid())
  itemName            String   @map("item_name")
  brandSpecifications String   @map("brand_specifications")
  availableQuantity   Int      @default(0) @map("available_quantity")
  unit                String
  description         String?
  purchaseReceipt     String?  @map("purchase_receipt") // Path file
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("em_stock_items")
}

// Pengganti em_calibrations
model Calibration {
  id                 String        @id @default(uuid())
  deviceName         String        @map("device_name")
  serialNo           String        @map("serial_no")
  calibrationDate    DateTime      @map("calibration_date") @db.Date
  calibrationExpiry  DateTime      @map("calibration_expiry_date") @db.Date
  deviceCondition    ToolCondition? @map("device_condition")
  calibrationAgency  String?       @map("calibration_agency")
  calibrationLocation String?      @map("calibration_location")
  personName         String?       @map("person_name") // Nama manual jika needed
  
  // Relasi ke Pegawai (User yang input)
  createdByPegawaiId Int?          @map("created_by_pegawai_id")
  createdBy          pegawai?      @relation("CalibrationCreator", fields: [createdByPegawaiId], references: [id])
  
  createdAt          DateTime      @default(now()) @map("created_at")

  @@map("em_calibrations")
}

// Pengganti em_loans (Parent)
model Loan {
  id              String     @id @default(uuid())
  borrowerName    String     @map("borrower_name") // Bisa nama manual atau ambil dari relasi pegawai
  loanDate        DateTime   @map("loan_date") @db.Date
  returnDate      DateTime   @map("return_date") @db.Date
  
  // Project info (Tetap String agar fleksibel seperti request emergent, 
  // tapi kamu bisa hubungkan ke model Proyek lama jika mau)
  projectName     String     @map("project_name") 
  wbsProjectNo    String     @map("wbs_project_no")
  projectLocation String     @map("project_location")

  // Relasi ke Pegawai (Siapa yang input data ini/Admin)
  createdByPegawaiId Int?    @map("created_by_pegawai_id")
  createdBy          pegawai? @relation("LoanCreator", fields: [createdByPegawaiId], references: [id])
  
  items           LoanItem[] 
  
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("em_loans")
}

// Pengganti em_loan_items (Child)
model LoanItem {
  id            String        @id @default(uuid())
  loanId        String        @map("loan_id")
  loan          Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  
  equipmentName String        @map("equipment_name")
  serialNo      String        @map("serial_no")
  condition     ToolCondition

  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("em_loan_items")
}